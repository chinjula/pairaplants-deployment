# ==============================================================================
# PAIRAPLANTS – PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env in local or enter into Vercel Project Settings > Environment Variables
# ==============================================================================

# Core Application Settings
PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# Security & Secrets (Generate strong 64-char hex strings)
JWT_SECRET=super_secret_staff_jwt_key_pairaplants_2026_enterprise
CUSTOMER_JWT_SECRET=super_secret_customer_jwt_key_pairaplants_2026_safe

# Persistent PostgreSQL Database (Supabase)
# Get these from https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Persistent Cloud Media & Image Storage (Cloudinary)
# Get these from https://cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=pairaplants-aquatics
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WhatsApp Business Integration
WHATSAPP_PHONE=919876543210
WHATSAPP_DEFAULT_MESSAGE="Hello Pairaplants! I have an inquiry about my aquarium order."

